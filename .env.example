# =============================================================================
# Environment variables — copy this file to .env and adjust.
#   cp .env.example .env
# The values below work for local development with Docker Compose.
# NEVER commit the real .env file.
# =============================================================================

# --- Brand ---------------------------------------------------------------------
# Placeholder until the brand name is decided. Used by backend and frontend.
PORTAL_NAME=PORTAL_NAME

# --- Django --------------------------------------------------------------------
# Which settings file to load: config.settings.local or config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Long random string. Generate a new one for production.
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-change-me
# True only in local development.
DJANGO_DEBUG=True
# Comma-separated host names Django will answer to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Frontend origins allowed to call the API from the browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) -------------------------------------------
# Used by the db container to create the database on first start.
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
# Used by Django. "postgis://" selects the GeoDjango PostGIS backend.
DATABASE_URL=postgis://portal:portal@db:5432/portal

# --- Redis / Celery ------------------------------------------------------------
# Cache and health checks.
REDIS_URL=redis://redis:6379/0
# Celery task queue (separate Redis database).
CELERY_BROKER_URL=redis://redis:6379/1

# --- External integrations -----------------------------------------------------
# "mock" = fake REGA / Nafath / ZATCA / SMS / WhatsApp / payments (local dev).
# "live" = real providers (production, once access is granted).
INTEGRATIONS_MODE=mock

# --- Login (phone OTP + JWT cookies) -------------------------------------------
# No SMS provider is signed yet: in mock mode the code is printed in the api logs
#   docker compose logs api | grep "mock sms"
# How long a login code stays valid, in seconds.
OTP_TTL_SECONDS=300
# Wrong guesses allowed per code before it stops working.
OTP_MAX_ATTEMPTS=5
# Seconds a phone must wait before asking for another code.
OTP_RESEND_SECONDS=60
# Most codes one phone can request per hour.
OTP_MAX_PER_HOUR=5
# True in production (cookies only sent over HTTPS). production.py forces it on.
AUTH_COOKIE_SECURE=False
# Leave empty locally. In production set the parent domain (e.g. .example.sa) so the
# site and the API subdomain share the login cookie.
AUTH_COOKIE_DOMAIN=

# --- Nafath (identity verification for brokers, agencies and owners) ----------
# Only used when INTEGRATIONS_MODE=live. In mock mode every verification is
# approved straight away. Filled in once the integration route is agreed.
NAFATH_BASE_URL=
NAFATH_APP_ID=
NAFATH_APP_KEY=

# --- REGA (advertising licence data for every listing) -------------------------
# Only used when INTEGRATIONS_MODE=live. In mock mode licence data is invented from
# the number: ending 0000 = not found, 9999 = expired, 8888 = another broker's licence.
REGA_BASE_URL=
REGA_API_KEY=

# --- Listings ------------------------------------------------------------------
# Days a listing stays live after approval (the paid "post" period).
LISTING_POST_DAYS=30
# Largest photo a browser may upload, in megabytes, and the most photos per listing.
LISTING_PHOTO_MAX_MB=10
LISTING_PHOTO_MAX_COUNT=30

# --- Leads (WhatsApp / call / enquiry form) -----------------------------------
# Secret mixed into the visitor fingerprint that stops repeat clicks counting twice.
# No raw IP addresses are stored. Generate a new one for production: openssl rand -hex 32
LEAD_HASH_SALT=local-dev-lead-salt
# WhatsApp Cloud API (Meta) used to tell brokers about new leads. Only used when
# INTEGRATIONS_MODE=live; in mock mode the notice is printed in the api logs:
#   docker compose logs api | grep "mock whatsapp"
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Name of the approved message template (body parameters: reference, channel, name, phone).
WHATSAPP_LEAD_TEMPLATE=new_lead

# --- File storage (SeaweedFS locally, OCI Object Storage in production) --------
# S3-compatible API used by Django and imgproxy. Locally these point at the
# "storage" container (SeaweedFS), which creates this access key on start.
S3_ENDPOINT_URL=http://storage:8333
S3_ACCESS_KEY=localdevaccesskey
S3_SECRET_KEY=localdevsecretkey
S3_BUCKET=portal-media
# OCI uses region names like me-jeddah-1 or me-riyadh-1. SeaweedFS ignores it.
S3_REGION=us-east-1
# Public base URL that browsers use to reach files (no trailing slash).
S3_PUBLIC_URL=http://localhost:8333/portal-media
# S3 API address as browsers see it (no bucket). Photo upload URLs are signed for it.
# Defaults to S3_ENDPOINT_URL; set it whenever that address only works inside Docker.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- imgproxy (image resizing) -------------------------------------------------
# Hex-encoded key and salt used to sign image URLs. Generate new ones for production:
#   openssl rand -hex 32
IMGPROXY_KEY=943b421c9eb07c830af81030552c86009268de4e532ba2ee2eab8247c6da0881
IMGPROXY_SALT=520f986b998545b4785e0defbc4f3c1203f22de2374a3d53cb7a7fe9fea309c5
# Public base URL of imgproxy.
IMGPROXY_URL=http://localhost:8081

# --- Email ---------------------------------------------------------------------
# Locally all email is caught by Mailpit: http://localhost:8025
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Frontend (Next.js) --------------------------------------------------------
# API address as seen from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# API address as seen from the Next.js server inside Docker (server-side rendering).
API_INTERNAL_URL=http://api:8000
# Public address of the website, used for canonical URLs, hreflang and Open Graph links.
SITE_URL=http://localhost:3000
# MapLibre style (map tiles). OpenFreeMap is free and needs no key; only map images load
# from it, no user or listing data is sent. Swap for a Mapbox/other style URL later.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
